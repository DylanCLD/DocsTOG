NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
BOOTSTRAP_ADMIN_EMAILS=you@example.com,teammate@example.com
# Optional: enables the MCP endpoint (/api/mcp), read-only. At least 32 characters, e.g. `openssl rand -hex 32`.
MCP_TOKEN=
# Optional: set to true to also enable the MCP write tools (create, edit, move, delete). Off by default.
MCP_ALLOW_WRITE=
